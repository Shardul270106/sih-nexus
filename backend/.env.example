# ─── Server ──────────────────────────────────────────────────────
PORT=5000

# Comma-separated allowlist of frontend origins (production).
# In development, ANY localhost / 127.0.0.1 port is accepted automatically,
# because Vite increments the port when 5173 is busy (5174, 5175, ...).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── Database ────────────────────────────────────────────────────
# Local Docker:
MONGODB_URI=mongodb://127.0.0.1:27017/agni_drishti
# Or MongoDB Atlas (replace with your own connection string):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agni_drishti?retryWrites=true&w=majority

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRE=7d

# ─── NASA FIRMS ──────────────────────────────────────────────────
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Leave FIRMS_MAP_KEY empty to run in SYNTHETIC DEMO mode (auto-generated data).
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
